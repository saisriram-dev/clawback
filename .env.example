# Copy to .env.local (or run setup-gemma.bat, which writes it for you).
# On Render these are set by render.yaml; you only paste GEMMA_API_KEY.

# ---- Gemma (required to read documents with AI) -------------------------------------
# Option 1: Google AI Studio / Gemini API serving Gemma 4 (free key: https://aistudio.google.com/apikey)
GEMMA_PROVIDER=google
GEMMA_MODEL=gemma-4-26b-a4b-it
GEMMA_API_KEY=paste-your-key-here

# Option 2: Ollama on this computer (offline). Install from https://ollama.com, then: ollama pull gemma4:e4b
# GEMMA_PROVIDER=ollama
# GEMMA_MODEL=gemma4:e4b
# GEMMA_BASE_URL=http://127.0.0.1:11434

# auto = Gemma reads every document and the rules engine cross-checks it (and takes over if Gemma is down).
CLAWBACK_ENGINE_MODE=auto

# ---- Server -------------------------------------------------------------------------
# Signs login cookies. Use a long random string. If unset, one is created in data/.auth-secret.
# AUTH_SECRET=change-me-to-a-long-random-string

# Where accounts, workspaces and uploads are stored (default ./data). On Render: /var/data (the disk).
# CLAWBACK_DATA_DIR=C:\ClawBackData

# PORT=3000
