{
  "name": "clawback",
  "version": "1.0.0",
  "private": true,
  "description": "ClawBack: Indian exporters recover their share of US IEEPA tariff refunds from their buyers. Gemma reads the documents, deterministic code does the math, a human approves every number.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "launch": "node scripts/launch.mjs",
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "start:lan": "next start -H 0.0.0.0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "doctor": "node scripts/doctor.mjs",
    "demo:generate": "node scripts/make-demo-docs.mjs",
    "start:render": "next start -H 0.0.0.0",
    "setup:gemma": "node scripts/setup-gemma.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-serif": "5.3.0",
    "mammoth": "1.13.0",
    "next": "15.5.27",
    "postal-mime": "4.0.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "read-excel-file": "9.3.12",
    "unpdf": "1.8.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "pdf-lib": "1.17.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
